{
  "name": "marquee",
  "private": true,
  "version": "0.2.2",
  "description": "A controller-first game launcher for the television",
  "license": "PolyForm-Strict-1.0.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/FomasTreeman/marquee"
  },
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "app": "tauri dev",
    "tokens": "python3 tools/build-tokens.py",
    "logs": "tail -f \"$HOME/Library/Logs/Marquee/marquee.log\"",
    "test": "pnpm check && node .github/scripts/board.test.mjs && vitest run && tsc --noEmit && cd src-tauri && cargo test",
    "test:ui": "vitest run",
    "build:windows": "tools/build-windows.sh",
    "check": "tools/check-silence.sh && python3 tools/check-workflows.py && python3 tools/check-agent-tools.py"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2",
    "typescript": "^5.7.0",
    "vite": "^6.0.0",
    "vitest": "^4.1.11"
  },
  "dependencies": {
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-dialog": "^2.7.2",
    "@tauri-apps/plugin-process": "^2.3.1",
    "@tauri-apps/plugin-updater": "^2.10.1"
  }
}
